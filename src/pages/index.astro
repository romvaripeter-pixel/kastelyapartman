				path: "M535,503 L449,145 L922,35 L934,57 L983,67 L1025,79 L1023,101 L1065,128 L1082,113 L1092,128 L1085,155 L1104,185 L1121,185 L1129,197 L1109,251 L1129,261 L1119,296 L1089,333 L1092,348 L937,402 L912,520 L557,611 Z"
			},
			{
				id: "dining",
				title: "Étkező",
				image: diningImg,
				points: "932,395,904,403,817,237,827,101,920,83,1004,99,1067,134,1100,189,1084,257,1074,284,1057,303,1001,328,919,356",
				path: "M932,395 L904,403 L817,237 L827,101 L920,83 L1004,99 L1067,134 L1100,189 L1084,257 L1074,284 L1057,303 L1001,328 L919,356 Z"
			},
			{
				id: "hall",
				title: "Hall",
				image: hallImg,
				points: "601,878,548,634,562,628,523,496,969,380,1089,720,1022,741,1018,730,990,802,635,917",
				path: "M601,878 L548,634 L562,628 L523,496 L969,380 L1089,720 L1022,741 L1018,730 L990,802 L635,917 Z"
			},
			{
				id: "bathroom",
				title: "Fürdőszoba",
				image: bathroomImg,
				points: "599,867,658,1153,924,1059,840,786",
				path: "M599,867 L658,1153 L924,1059 L840,786 Z"
			},
			{
				id: "kitchen",
				title: "Konyha",
				image: kitchenPlanImg,
				points: "910,517,936,403,1190,343,1280,541,1266,562,1290,625,1304,622,1316,658,1024,750,996,802",
				path: "M910,517 L936,403 L1190,343 L1280,541 L1266,562 L1290,625 L1304,622 L1316,658 L1024,750 L996,802 Z"
			}
		]}
	/>

	<ReviewsGalaxy
		headline="Számtalan emlék, egyetlen közös történet."
		airbnbLogo={airbnbLogo}
		bookingLogo={bookingLogo}
		reviews={[
			{ id: "rodrigo", snippet: "Csodálatos hely", fullText: "Csodálatos hely. Nagyon ízlésesen berendezett, elegáns bútorokkal és modern konyhai gépekkel. A magas belmagasság és különösen a fő hálószoba nemes hangulatot árasztott — akár egy londoni vagy párizsi ötcsillagos szálloda lakosztálya is lehetne. Makulátlan tisztaság, tökéletes elhelyezkedés, csendes környezet, mégis pár perc sétára a történelmi belvárostól és a vártól. Joli rendkívül kedves és segítőkész házigazda. A saját garázs nagy kényelmet jelentett. A szomszédok is nagyon barátságosak voltak. A lakás tágas, otthonos érzést nyújt, kiváló Sonos hangrendszerrel. Mindenkinek ajánlom.", guestName: "Rodrigo", source: "airbnb", x: 82.8, y: 50.0, depth: 0.30 },
			{ id: "michal", snippet: "Minden várakozást felülmúl", fullText: "Luxus és rendkívül igényes apartman, gyönyörűen felújítva és berendezve. Joli részletes segítséget nyújtott az érkezéshez. A hely minden várakozást felülmúl. Tiszta, tágas, minden részletre odafigyeltek. Teljesen felszerelt konyha, kényelmes ágyak, nagy fürdőszoba, kellemes környezet. Biztosan visszatérnék.", guestName: "Michal", source: "airbnb", x: 30.0, y: 71.9, depth: 0.83 },
			{ id: "michael-2", snippet: "Felsőkategóriás elegancia", fullText: "Peter és Jola kiváló házigazdák voltak, rendkívül kedvesek és segítőkészek. A szállás a felsőkategóriás elegancia tökéletes példája. A belső tér és a bútorok kifinomultak és ízlésesek voltak. Már-már azt vártam, mikor sétál be a komornyik a nappaliba. 😀", guestName: "Michael", source: "airbnb", x: 54.5, y: 35.0, depth: 0.66 },
			{ id: "sara", snippet: "A valóságban még szebb", fullText: "Nagyon elégedettek voltunk a tartózkodásunkkal! A valóságban még szebb, mint a képeken. Rengeteg hely van, és minden megtalálható benne, amire szükség lehet. Szívből ajánlom a következő egri látogatáshoz.", guestName: "Sara", source: "airbnb", x: 84.3, y: 82.1, depth: 0.49 },
			{ id: "george", snippet: "Közel a központhoz, mégis csendes", fullText: "Gyönyörűen és ízlésesen felújított, nagyon tágas apartman. Kiváló hangszigetelés, annak ellenére, hogy egy téren található, szinte semmi forgalmi zaj nem hallható. Jól felszerelt konyha, könnyen megközelíthető belváros.", guestName: "George", source: "airbnb", x: 10.0, y: 41.4, depth: 0.32 },
			{ id: "martina", snippet: "Fantasztikus", fullText: "Minden fantasztikus volt, a lakás gyönyörű és minden szempontból igényes. Teljesen felszerelt, hat fő számára is tökéletes. A belváros mindössze öt perc sétára van egy hangulatos patakparti úton. Jolán nagyon kedves és segítőkész volt, gyorsan válaszolt és rugalmasan kezelte az érkezést és távozást.", guestName: "Martina", source: "airbnb", x: 90.0, y: 24.8, depth: 0.85 },
			{ id: "eniko", snippet: "Akárcsak egy ötcsillagos szálloda", fullText: "Csodaszép lakás volt, akárcsak egy ötcsillagos szállodai apartman. Minden pontosan olyan, mint a képeken. Tágas, otthonos, szép és ízléses. Nagyon jól éreztük magunkat, bátran ajánlom mindenkinek.", guestName: "Enikő", source: "airbnb", x: 39, y: 85.0, depth: 0.35 },
			{ id: "yunjin", snippet: "Ilyet még sosem tapasztaltam", fullText: "Számtalan Airbnb-ben megszálltam már, de ilyet még sosem tapasztaltam. Eredetileg estére programot terveztem, de a lakás annyira lenyűgöző volt, hogy inkább otthon maradtam főzni és pihenni. Tágas, gyönyörű, mindennel felszerelt. A konyhában még tészta is volt. A fürdőszoba makulátlan tisztaságú volt. A házigazdák gyorsan válaszoltak, és segítettek a korai bejelentkezésben és a késői kijelentkezésben is. Teljes bizalommal ajánlom.", guestName: "Yunjin", source: "airbnb", x: 28.7, y: 20.6, depth: 1.00 },
			{ id: "ferenc", snippet: "Remek elhelyezkedés", fullText: "Patyolat tiszta, jól felszerelt, tágas apartman, pontosan olyan, mint a képeken. Remek elhelyezkedés, kifogástalan minden szempontból. Három gyermekkel érkeztünk, ők is imádták. Egyszerűen tíz pont.", guestName: "Ferenc", source: "booking", x: 90, y: 61.8, depth: 0.34 },
			{ id: "jagoda", snippet: "Békés és pihentető légkör", fullText: "Fantasztikus! A Kastély Apartman nagyon kellemes, gondozott és kényelmes szálláshely. Tiszta, esztétikusan berendezett és kiválóan felszerelt. A légkör békés és pihentető. Külön kiemelném a tulajdonos becsületességét és kedvességét. Távozás után vettük észre, hogy ott felejtettük a pénztárcánkat, amelyet a tulajdonos sértetlenül visszaküldött. Szívből ajánlom.", guestName: "Jagoda", source: "booking", x: 10.0, y: 65.8, depth: 0.87 },
			{ id: "zoltan", snippet: "Egészen pazar", fullText: "Egészen pazar. A belvárostól 500 méterre, a vártól 600 méterre, rendkívül csendes helyen található. Óriási szobák, igényes berendezés, privát parkolás és kifogástalan tisztaság.", guestName: "Zoltán", source: "booking", x: 75.0, y: 18.0, depth: 0.70 },
			{ id: "magdalena", snippet: "Királynőnek érezheti magát", fullText: "Ebben az apartmanban királynőnek érezheti magát. Fantasztikusan tágas, stílusosan berendezett lakás gyönyörű padlóval és elegáns enteriőrrel. A különálló WC és a kényelmes fürdőkád külön előnyt jelent. A biztonságos parkolás a szállás árát képezi. Kiváló kapcsolat a tulajdonossal.", guestName: "Magdalena", source: "booking", x: 71.5, y: 90.0, depth: 0.53 },
			{ id: "imre", snippet: "Fantasztikus hangulat", fullText: "Az apartman hangulata fantasztikus, mintha a XX. század elején járnánk, mégis modern. Nagyszerű belvárosi elhelyezkedés és rendkívül kedves, segítőkész szállásadó.", guestName: "Imre", source: "booking", x: 30.0, y: 37.1, depth: 0.36 },
			{ id: "krisztina", snippet: "Mintha egy kastélyban szállna meg", fullText: "Az egyik legszebb apartman, ahol valaha jártunk! Olyan érzés, mintha egy kastélyban szállna meg az ember. Minden részletre figyeltek, gyönyörű bútorokkal rendezték be. A konyha kiválóan felszerelt. Egy csendes kis téren található, mégis közel a belvároshoz. A kapcsolattartó nagyon kedves és segítőkész volt.", guestName: "Krisztina", source: "booking", x: 90.0, y: 35.0, depth: 0.89 }
		]}
	/>
	<CityMap
		mapImage={cityMapImage}
		items={[
			{
				id: "apartman",
				title: "Kastély Apartman – A tökéletes bázis Eger felfedezéséhez!",
				text: "Belvárosi elhelyezkedése ellenére az apartman egy csendes, zöld sarokban bújik meg. Ideális kiindulópont a város titkainak megismeréséhez, egy tartalmas nap után pedig tökéletes helyszín a csendes relaxálásra.",
				icon: iconApartman,
				photo: photoApartman,
				left: 50.46,
				top: 27.21,
				isApartment: true
			},
			{
				id: "dobo-ter",
				title: "Dobó István tér",
				text: "Indítsd az egri kalandot a város pezsgő szívében! Ezen az emblematikus főtéren a lenyűgöző barokk épületek között sétálva azonnal magával ragad majd a hely hamisítatlan, történelmi hangulata.",
				icon: iconDobo,
				photo: photoDobo,
				left: 64.42,
				top: 46.35
			},
			{
				id: "egri-var",
				title: "Egri vár",
				text: "Lépj be a legendák birodalmába, és járd be Magyarország egyik legnépszerűbb és leghíresebb erődítményét! Az egri hősök dicső múltja és a falakról nyíló csodás panoráma garantáltan felejthetetlen élménnyé teszi a látogatást.",
				icon: iconVar,
				photo: photoVar,
				left: 70.80,
				top: 39.19
			},
			{
				id: "erseki-palota",
				title: "Egri Érseki Palota",
				text: "Engedd, hogy elvarázsoljon a belváros egyik legszebb, legértékesebb és legimpozánsabb építészeti remekműve. Az egykori főpapi rezidencia falai között bepillantást nyerhetsz az érsekek fényűző és titokzatos hétköznapjaiba.",
				icon: iconErseki,
				photo: photoErseki,
				left: 50.53,
				top: 47.63
			},
			{
				id: "egri-bazilika",
				title: "Egri Bazilika",
				text: "Csodáld meg Magyarország második legnagyobb templomát, amely a klasszicista művészet egyik legkiemelkedőbb hazai alkotása. Monumentális belső tere és fenséges orgonája téged is egészen biztosan le fog nyűgözni.",
				icon: iconBazilika,
				photo: photoBazilika,
				left: 52.45,
				top: 55.99
			},
			{
				id: "minaret",
				title: "Minaret",
				text: "Tekints meg egy igazi világkülönlegességet, a keresztény kereszttel büszkélkedő török kori imatornyot! Ha nem ijedsz meg a szűk lépcsőfokoktól, a tetejéről páratlan kilátás nyílik az egész belvárosra.",
				icon: iconMinaret,
				photo: photoMinaret,
				left: 60.52,
				top: 34.02
			},
			{
				id: "szepasszony-volgy",
				title: "Szépasszony-völgy",
				text: "Ha Eger, akkor a bor sem maradhat ki: ez a völgy a borkóstolás abszolút első számú és legikonikusabb helyszíne a városban. Kóstolj bele a híres Egri Bikavérbe a hangulatos, riolittufába vájt pincerendszerek rejtekében!",
				icon: iconSzepasszony,
				photo: photoSzepasszony,
				left: 8.86,
				top: 80.72
			},
			{
				id: "csillagvizsgalo",
				title: "Csillagvizsgáló és Tudományos Élményközpont",
				text: "Fedezd fel a kontinens legrégebbi, máig működő camera obscura eszközét, amellyel élőben kémlelheted a várost! A Líceum tetején található központ ráadásul lélegzetelállító panorámát és izgalmas tudományos kalandokat tartogat.",
				icon: iconCsillag,
				photo: photoCsillag,
				left: 61.66,
				top: 54.64
			},
			{
				id: "termalfurdo",
				title: "Termálfürdő",
				text: "Kapcsolódj ki az ország egyik legszebb és legzöldebb városi strandján, egy hatalmas, 5 hektáros parkban! A 13 különböző medence és a gyógyító termálvíz tökéletes felfrissülést nyújt az egész családnak a városnézés után.",
				icon: iconTermal,
				photo: photoTermal,
				left: 83.35,
				top: 63.78
			}
		]}
	/>
	<Contact
		heading="Kapcsolat"
		intro="Ha foglalni szeretne, vagy kérdése van, várjuk emailjét, vagy hívjon bizalommal!"
		address="Tűzoltó tér, Eger, Hungary"
		email="romvari.peter@gmail.com"
		phone="+36 30 638 7740"
		phoneName="Vincze Jolán"
		links={[
			{ name: "Airbnb", href: "https://airbnb.com/h/kastelyapartman", logo: airbnbLogoFull },
			{ name: "Booking.com", href: "https://www.booking.com/hotel/hu/kastely-apartman-eger.hu.html", logo: bookingLogo },
