---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import heroImage from '../assets/images/bedroom01.jpg';
---

<Layout
	title="Kastély Apartman | Eger"
	description="Luxus otthon Eger szívében – felújított, elegáns apartman rövid távú kiadásra."
	lang="hu"
>
	<Hero
		image={heroImage}
		title="Kastély Apartman"
		subtitle="Luxus otthon Eger szívében"
	/>
	<Welcome
		heading="Luxus otthon Eger szívében"
		text="Élvezze egy letűnt korszak eleganciáját újonnan felújított otthonunkban. A tágas Kastély Apartman a korabeli belsőépítészet egyedi elemeit és a kortárs részleteket vegyíti. A történelmi város szívében, a vásárcsarnoktól és a Dobó tértől kőhajításnyira található apartman teljesen felszerelt, hogy az Ön otthona legyen. A hálószobákhoz tartozik egy nagy hálószoba king-size ággyal és egy vendég hálószoba két egyszemélyes ággyal. A nappali kanapéja franciaággyá alakítható, így összesen 6 vendég aludhat az apartmanban."
	/>
</Layout>