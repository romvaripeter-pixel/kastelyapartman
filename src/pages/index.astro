---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import heroImage from '../assets/images/bedroom01.jpg';
import livingImg from '../assets/images/living01.jpg';
import outsideImg from '../assets/images/outisde01.jpg';
import kitchenImg from '../assets/images/kitchen03.jpg';
import netflixImg from '../assets/images/living04_Netflix.jpg';
import parkingImg from '../assets/images/parking01.jpg';
import Services from '../components/Services.astro';
import RoomPlan from '../components/RoomPlan.astro';
import planImage from '../assets/images/plan03.jpg';
import bedroomMasterImg from '../assets/images/bedroom01.jpg';
import bedroomSecondImg from '../assets/images/bedroom04.jpg';
import livingRoomImg from '../assets/images/living01.jpg';
import diningImg from '../assets/images/dining01.jpg';
import hallImg from '../assets/images/central_hall_01.jpg';
import bathroomImg from '../assets/images/bathroom01.jpg';
import kitchenPlanImg from '../assets/images/kitchen01.jpg';

import CityMap from '../components/CityMap.astro';
import cityMapImage from '../assets/images/city-map-blank.jpg';

import iconApartman from '../assets/images/icon-kastely-apartman.png';
import iconMinaret from '../assets/images/icon-minaret.png';
import iconVar from '../assets/images/icon-egri-var.png';
import iconDobo from '../assets/images/icon-dobo-ter.png';
import iconErseki from '../assets/images/icon-erseki-palota.png';
import iconCsillag from '../assets/images/icon-csillagvizsgalo.png';
import iconBazilika from '../assets/images/icon-egri-bazilika.png';
import iconTermal from '../assets/images/icon-termalfurdo.png';
import iconSzepasszony from '../assets/images/icon-szepasszony-volgy.png';

import photoApartman from '../assets/images/photo-kastely-apartman.jpg';
import photoMinaret from '../assets/images/photo-minaret.jpg';
import photoVar from '../assets/images/photo-egri-var.jpg';
import photoDobo from '../assets/images/photo-dobo-ter.jpg';
import photoErseki from '../assets/images/photo-erseki-palota.jpg';
import photoCsillag from '../assets/images/photo-csillagvizsgalo.jpg';
import photoBazilika from '../assets/images/photo-egri-bazilika.jpg';
import photoTermal from '../assets/images/photo-termalfurdo.jpg';
import photoSzepasszony from '../assets/images/photo-szepasszony-volgy.jpg';

import ReviewsGalaxy from '../components/ReviewsGalaxy.astro';
import airbnbLogo from '../assets/images/logo-airbnb.svg';
import bookingLogo from '../assets/images/logo-booking.svg';

import Contact from '../components/Contact.astro';
import logoSzallas from '../assets/images/logo-szallas.svg';
import airbnbLogoFull from '../assets/images/logo-airbnb-full.svg';
import bookingLogoFull from '../assets/images/logo-booking-full.svg';
---

<Layout
	title="Kastély Apartman | Eger"
	description="Luxus otthon Eger szívében – felújított, elegáns apartman rövid távú kiadásra."
	lang="hu"
>
	<Hero
		image={heroImage}
		title="Kastély Apartman"
		subtitle="Luxus otthon Eger szívében"
	/>
	<Welcome
		heading="Luxus otthon Eger szívében"
		text="Élvezze egy letűnt korszak eleganciáját újonnan felújított otthonunkban. A tágas Kastély Apartman a korabeli belsőépítészet egyedi elemeit és a kortárs részleteket vegyíti. A történelmi város szívében, a vásárcsarnoktól és a Dobó tértől kőhajításnyira található apartman teljesen felszerelt, hogy az Ön otthona legyen. A hálószobákhoz tartozik egy nagy hálószoba king-size ággyal és egy vendég hálószoba két egyszemélyes ággyal. A nappali kanapéja franciaággyá alakítható, így összesen 6 vendég aludhat az apartmanban."
	/>
	<Services
		heading="Amit kínálunk"
		intro="Mindent megtalál nálunk, amire egy kényelmes és pihentető tartózkodáshoz szüksége lehet. Ha mégis hiányozna valami, csak szóljon – szívesen segítünk!"
		items={[
			{
				image: livingImg,
				title: "Teljes lakás",
				text: "A teljes apartman kizárólag az Ön rendelkezésére áll, így bőséges tér jut a családoknak, pároknak vagy baráti társaságoknak a kikapcsolódásra és feltöltődésre."
			},
			{
				image: outsideImg,
				title: "Kiváló elhelyezkedés",
				text: "Az apartman csupán néhány perc sétára található a Dobó tértől és az Egri Vártól. Könnyedén elérheti a belváros legfontosabb látnivalóit, miközben egy csendes, nyugodt környezetben pihenhet."
			},
			{
				image: kitchenImg,
				title: "Teljesen felszerelt konyha",
				text: "Akár egy gyors reggelit készítene, akár saját maga főzne, minden szükséges eszközt megtalál a konyhában, beleértve a vízforralót, a kávéfőzőt, a mosogatógépet és számos egyéb konyhai felszerelést."
			},
			{
				image: netflixImg,
				title: "Modern kényelmi szolgáltatások",
				text: "Élvezze a villámgyors Wi-Fit, nézze kedvenc műsorait az 55 colos okostévén, hallgasson zenét a Sonos okoshangszórón keresztül, vagy dolgozzon kényelmesen a dedikált munkasarokban. Elegancia a mai elvárásoknak megfelelően."
			},
			{
				image: parkingImg,
				title: "Saját parkolóhely",
				text: "Felejtse el a parkolással járó stresszt! A helyszíni parkolónak köszönhetően autóját biztonságosan, az apartman közvetlen közelében hagyhatja."
			}
		]}
	/>
	<RoomPlan
		planImage={planImage}
		buildingPath="M28,1341 L45,1158 L101,1148 L108,1030 L60,1017 L68,883 L120,874 L125,807 L81,772 L91,608 L129,600 L133,559 L96,511 L94,467 L501,359 L449,149 L921,36 L933,59 L963,63 L991,70 L1025,82 L1021,104 L1064,135 L1082,121 L1093,134 L1084,160 L1103,191 L1124,189 L1129,201 L1113,244 L1111,259 L1129,266 L1119,298 L1106,333 L1178,317 L1279,548 L1268,568 L1294,631 L1303,628 L1365,779 L1136,870 L1169,968 L1096,1015 L998,1051 L1003,1061 L1037,1076 L984,1094 L1001,1062 L995,1052 L713,1156 L718,1188 Z"
		rooms={[
			{
				id: "bedroom-master",
				title: "Háló",
				image: bedroomMasterImg,
				points: "32,1333,719,1181,602,620,83,748",
				path: "M32,1333 L719,1181 L602,620 L83,748 Z"
			},
			{
				id: "bedroom-second",
				title: "Háló",
				image: bedroomSecondImg,
				points: "81,764,94,609,133,601,133,557,96,512,96,466,503,357,564,643",
				path: "M81,764 L94,609 L133,601 L133,557 L96,512 L96,466 L503,357 L564,643 Z"
			},
			{
				id: "living",
				title: "Nappali",
