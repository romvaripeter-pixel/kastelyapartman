---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Welcome from '../../components/Welcome.astro';
import Services from '../../components/Services.astro';
import RoomPlan from '../../components/RoomPlan.astro';
import CityMap from '../../components/CityMap.astro';

import heroImage from '../../assets/images/bedroom01.jpg';

import livingImg from '../../assets/images/living01.jpg';
import outsideImg from '../../assets/images/outisde01.jpg';
import kitchenImg from '../../assets/images/kitchen03.jpg';
import netflixImg from '../../assets/images/living04_Netflix.jpg';
import parkingImg from '../../assets/images/parking01.jpg';

import planImage from '../../assets/images/plan03.jpg';
import bedroomMasterImg from '../../assets/images/bedroom01.jpg';
import bedroomSecondImg from '../../assets/images/bedroom04.jpg';
import livingRoomImg from '../../assets/images/living01.jpg';
import diningImg from '../../assets/images/dining01.jpg';
import hallImg from '../../assets/images/central_hall_01.jpg';
import bathroomImg from '../../assets/images/bathroom01.jpg';
import kitchenPlanImg from '../../assets/images/kitchen01.jpg';

import cityMapImage from '../../assets/images/city-map-blank.jpg';

import iconApartman from '../../assets/images/icon-kastely-apartman.png';
import iconMinaret from '../../assets/images/icon-minaret.png';
import iconVar from '../../assets/images/icon-egri-var.png';
import iconDobo from '../../assets/images/icon-dobo-ter.png';
import iconErseki from '../../assets/images/icon-erseki-palota.png';
import iconCsillag from '../../assets/images/icon-csillagvizsgalo.png';
import iconBazilika from '../../assets/images/icon-egri-bazilika.png';
import iconTermal from '../../assets/images/icon-termalfurdo.png';
import iconSzepasszony from '../../assets/images/icon-szepasszony-volgy.png';

import photoApartman from '../../assets/images/photo-kastely-apartman.jpg';
import photoMinaret from '../../assets/images/photo-minaret.jpg';
import photoVar from '../../assets/images/photo-egri-var.jpg';
import photoDobo from '../../assets/images/photo-dobo-ter.jpg';
import photoErseki from '../../assets/images/photo-erseki-palota.jpg';
import photoCsillag from '../../assets/images/photo-csillagvizsgalo.jpg';
import photoBazilika from '../../assets/images/photo-egri-bazilika.jpg';
import photoTermal from '../../assets/images/photo-termalfurdo.jpg';
import photoSzepasszony from '../../assets/images/photo-szepasszony-volgy.jpg';

import ReviewsGalaxy from '../../components/ReviewsGalaxy.astro';
import airbnbLogo from '../../assets/images/logo-airbnb.svg';
import bookingLogo from '../../assets/images/logo-booking.svg';

import Contact from '../../components/Contact.astro';
import logoSzallas from '../../assets/images/logo-szallas.svg';
import airbnbLogoFull from '../../assets/images/logo-airbnb-full.svg';
import bookingLogoFull from '../../assets/images/logo-booking-full.svg';

import heroLogo from '../../assets/images/KASTELY_LOGO_W_TEXT.png';

import gallery1Img from '../../assets/images/living05.jpg';
import gallery2Img from '../../assets/images/bedroom03.jpg';
---

<Layout
	title="Kastély Apartman | Eger"
	description="Luxury home in the heart of Eger – newly renovated, elegant apartment for short-term rental."
	lang="en"
>
	<Hero
		image={heroImage}
		logo={heroLogo}
	/>

	<Welcome
		intro="Experience Eger from a haven of curated style and effortless grace. Designed for the discerning traveler, this elegant apartment serves as the perfect launchpad for exploring the city's winding streets and legendary vineyards. Consider it more than just a place to stay—it is a sophisticated prelude to your journey."
		image={livingImg}
		title="A historic soul with a contemporary pulse? Absolutely."
		text="Stepping into this newly renovated sanctuary means experiencing a masterclass in interior aesthetic, where the grand proportions of a bygone era blend seamlessly with striking modern details. Tucked into the absolute heart of the old town, you are just a stone's throw from the vibrant market hall and the cobblestones of Dobó Square, making the entire city effortlessly accessible. The apartment is fully equipped to serve as your private retreat, featuring a master bedroom with a plush king-size bed, a versatile guest bedroom with two single beds, and a premium living room sofa that converts into a double bed to comfortably host up to six guests. It is a space where upscale style meets effortless functionality, offering everything you need to settle in and make Eger entirely your own."
		gallery1={gallery1Img}
		gallery2={gallery2Img}
	/>

	<Services
		heading="What we offer"
		intro="We offer a full range of amenities to make your stay comfortable and relaxing. If there's anything you need that you can't find, just ask—we're happy to help!"
		items={[
			{
				image: livingImg,
				title: "Entire apartment",
				text: "Enjoy exclusive access to the entire apartment, with plenty of space for families, couples, or groups to relax and feel at home."
			},
			{
				image: outsideImg,
				title: "Convenient Location",
				text: "Located just a short walk from Dobó Square and Eger Castle, the apartment offers easy access to the city centre while being tucked away in a quiet corner for a peaceful and relaxing stay."
			},
			{
				image: kitchenImg,
				title: "Fully equipped kitchen",
				text: "Whether you prefer cooking your own meals or preparing a quick breakfast, you'll find everything you need, including a kettle, coffee maker, dishwasher, and a wide range of kitchen essentials."
			},
			{
				image: netflixImg,
				title: "Modern amenities",
				text: "Stay connected with ultra-fast Wi-Fi, enjoy your favourite streaming services on the 55-inch Smart TV, listen to music through the Sonos smart speaker, or catch up on work at the dedicated desk. Modern comfort and elegance come as standard."
			},
			{
				image: parkingImg,
				title: "On site parking",
				text: "Leave your parking worries behind. Our convenient on-site parking allows you to park safely just steps from the apartment."
			}
		]}
	/>

	<RoomPlan
		planImage={planImage}
		placeholderText="Hover over a room to explore"
		buildingPath="M28,1341 L45,1158 L101,1148 L108,1030 L60,1017 L68,883 L120,874 L125,807 L81,772 L91,608 L129,600 L133,559 L96,511 L94,467 L501,359 L449,149 L921,36 L933,59 L963,63 L991,70 L1025,82 L1021,104 L1064,135 L1082,121 L1093,134 L1084,160 L1103,191 L1124,189 L1129,201 L1113,244 L1111,259 L1129,266 L1119,298 L1106,333 L1178,317 L1279,548 L1268,568 L1294,631 L1303,628 L1365,779 L1136,870 L1169,968 L1096,1015 L998,1051 L1003,1061 L1037,1076 L984,1094 L1001,1062 L995,1052 L713,1156 L718,1188 Z"
		rooms={[
			{
				id: "bedroom-master",
				title: "Master bedroom",
				image: bedroomMasterImg,
				points: "32,1333,719,1181,602,620,83,748",
				path: "M32,1333 L719,1181 L602,620 L83,748 Z"
			},
			{
				id: "bedroom-second",
				title: "Second bedroom",
				image: bedroomSecondImg,
				points: "81,764,94,609,133,601,133,557,96,512,96,466,503,357,564,643",
				path: "M81,764 L94,609 L133,601 L133,557 L96,512 L96,466 L503,357 L564,643 Z"
			},
			{
				id: "living",
				title: "Living room",
				image: livingRoomImg,
				points: "535,503,449,145,922,35,934,57,983,67,1025,79,1023,101,1065,128,1082,113,1092,128,1085,155,1104,185,1121,185,1129,197,1109,251,1129,261,1119,296,1089,333,1092,348,937,402,912,520,557,611",
				path: "M535,503 L449,145 L922,35 L934,57 L983,67 L1025,79 L1023,101 L1065,128 L1082,113 L1092,128 L1085,155 L1104,185 L1121,185 L1129,197 L1109,251 L1129,261 L1119,296 L1089,333 L1092,348 L937,402 L912,520 L557,611 Z"
			},
			{
				id: "dining",
				title: "Dining",
				image: diningImg,
				points: "932,395,904,403,817,237,827,101,920,83,1004,99,1067,134,1100,189,1084,257,1074,284,1057,303,1001,328,919,356",
				path: "M932,395 L904,403 L817,237 L827,101 L920,83 L1004,99 L1067,134 L1100,189 L1084,257 L1074,284 L1057,303 L1001,328 L919,356 Z"
			},
			{
				id: "hall",
				title: "Hall",
				image: hallImg,
				points: "601,878,548,634,562,628,523,496,969,380,1089,720,1022,741,1018,730,990,802,635,917",
				path: "M601,878 L548,634 L562,628 L523,496 L969,380 L1089,720 L1022,741 L1018,730 L990,802 L635,917 Z"
			},
			{
				id: "bathroom",
				title: "Bathroom",
				image: bathroomImg,
				points: "599,867,658,1153,924,1059,840,786",
				path: "M599,867 L658,1153 L924,1059 L840,786 Z"
			},
			{
				id: "kitchen",
				title: "Kitchen",
				image: kitchenPlanImg,
				points: "910,517,936,403,1190,343,1280,541,1266,562,1290,625,1304,622,1316,658,1024,750,996,802",
				path: "M910,517 L936,403 L1190,343 L1280,541 L1266,562 L1290,625 L1304,622 L1316,658 L1024,750 L996,802 Z"
			}
		]}
	/>

	<ReviewsGalaxy
		headline="Our history is written by countless unforgettable moments."
		airbnbLogo={airbnbLogo}
		bookingLogo={bookingLogo}
		reviews={[
			{ id: "rodrigo", snippet: "Wonderful place", fullText: "Wonderful place. Very nicely decorated. Elegant furniture and sleek kitchen appliances. High ceilings, noble feeling, especially in the main bedroom. Very clean. Perfect location. Friendly host, convenient garage, welcoming neighbours, spacious rooms and excellent Sonos sound system. Highly recommended.", guestName: "Rodrigo", source: "airbnb", x: 82.8, y: 50.0, depth: 0.30 },
			{ id: "michal", snippet: "Above and beyond", fullText: "A luxurious and very indulgent apartment, renovated and decorative. Easy and detailed arrival provided by Joli. The place is above and beyond. Clean, spacious and thoughtfully equipped. I would definitely come back.", guestName: "Michal", source: "airbnb", x: 30.0, y: 71.9, depth: 0.83 },
			{ id: "michael-2", snippet: "High-end elegance", fullText: "Peter and Jola were excellent hosts during our stay. The property was high-end elegance with refined and sophisticated interiors. I wondered when the butler was going to walk through to the sitting area.", guestName: "Michael", source: "airbnb", x: 54.5, y: 35.0, depth: 0.66 },
			{ id: "sara", snippet: "Even more beautiful in real life", fullText: "We were super happy with the stay! It's even more beautiful in real life, with plenty of space and everything you need. I highly recommend it for your next visit to Eger.", guestName: "Sara", source: "airbnb", x: 84.3, y: 82.1, depth: 0.49 },
			{ id: "george", snippet: "Close to the centre, yet no traffic noise", fullText: "Beautiful, very tastefully refurbished apartment, very spacious. Excellent sound insulation, close to the city centre, yet virtually no traffic noise. Highly recommended.", guestName: "George", source: "airbnb", x: 10.0, y: 41.4, depth: 0.32 },
			{ id: "martina", snippet: "Fantastic", fullText: "Everything was fantastic, the apartment was beautiful and demanding in every way. Equipped with everything, perfect for 6 people. Jola was very helpful and responded immediately.", guestName: "Martina", source: "airbnb", x: 90.0, y: 24.8, depth: 0.85 },
			{ id: "eniko", snippet: "Just like a five-star hotel", fullText: "It was a beautiful apartment, just like a five-star hotel suite. Everything is exactly as in the pictures. Spacious, cosy, beautiful and tasteful. We had a great time and would definitely recommend it.", guestName: "Enikő", source: "airbnb", x: 39, y: 85.0, depth: 0.35 },
			{ id: "yunjin", snippet: "I've never experienced anything like this", fullText: "I've stayed at countless Airbnbs, but wow — I've never experienced anything like this. The apartment was so amazing that I cancelled my evening plans to stay in, cook and relax. Spacious, beautiful and perfectly equipped. Absolutely the best.", guestName: "Yunjin", source: "airbnb", x: 28.7, y: 20.6, depth: 1.00 },
			{ id: "ferenc", snippet: "Great location", fullText: "Very clean, well-equipped, spacious apartment, exactly as in the pictures, great location. Impeccable! We had 3 kids with us, they loved it too. A perfect ten.", guestName: "Ferenc", source: "booking", x: 90, y: 61.8, depth: 0.34 },
			{ id: "jagoda", snippet: "Peaceful and relaxing atmosphere", fullText: "Awesome! Kastély Apartman is a very pleasant, well-kept and comfortable place to stay. Clean, beautifully decorated and well equipped. The atmosphere is peaceful and relaxing. The owner's honesty and kindness deserve special praise.", guestName: "Jagoda", source: "booking", x: 10.0, y: 65.8, depth: 0.87 },
			{ id: "zoltan", snippet: "Absolutely splendid", fullText: "Absolutely splendid. 500 metres from the city centre and 600 metres from the castle. Very quiet location, huge rooms, tasteful furnishings, private parking and impeccable cleanliness.", guestName: "Zoltán", source: "booking", x: 75.0, y: 18.0, depth: 0.70 },
			{ id: "magdalena", snippet: "Feel like a queen", fullText: "In this apartment you can feel like a queen. Fantastic, spacious apartment with a stylish interior. Excellent contact with the owner and secure parking included.", guestName: "Magdalena", source: "booking", x: 71.5, y: 90.0, depth: 0.53 },
			{ id: "imre", snippet: "Fantastic atmosphere", fullText: "The atmosphere of the apartment is fantastic, as if you were stepping into the early 20th century, yet with all modern comforts. Very good location in the city centre and an extremely kind, helpful host.", guestName: "Imre", source: "booking", x: 30.0, y: 37.1, depth: 0.36 },
			{ id: "krisztina", snippet: "Feels like staying in a castle", fullText: "One of the nicest apartments we have ever stayed in. It feels like staying in a castle. Beautiful furniture, attention to detail, a well-equipped kitchen and a great location close to the city centre.", guestName: "Krisztina", source: "booking", x: 90.0, y: 35.0, depth: 0.89 }
		]}
	/>

	<CityMap
		mapImage={cityMapImage}
		items={[
			{
				id: "apartman",
				title: "Kastély Apartman – The perfect base for exploring Eger!",
				text: "Despite its downtown location, the apartment is tucked away in a quiet, green corner. It is the ideal starting point to discover the secrets of the city, and the perfect place for quiet relaxation after a full day.",
				icon: iconApartman,
				photo: photoApartman,
				left: 50.46,
				top: 27.21,
				isApartment: true
			},
			{
				id: "dobo-ter",
				title: "Dobó Square",
				text: "Start your adventure in the bustling heart of Eger! Walking among the stunning Baroque buildings of this emblematic main square, the authentic historical atmosphere of the city will instantly captivate you.",
				icon: iconDobo,
				photo: photoDobo,
				left: 64.42,
				top: 46.35
			},
			{
				id: "egri-var",
				title: "Castle of Eger",
				text: "Step into the realm of legends and explore one of Hungary's most popular and famous fortresses! The glorious past of the heroes of Eger and the wonderful panorama from the castle walls guarantee an unforgettable experience.",
				icon: iconVar,
				photo: photoVar,
				left: 70.80,
				top: 39.19
			},
			{
				id: "erseki-palota",
				title: "Archbishop's Palace",
				text: "Let yourself be enchanted by one of the city center's most beautiful, valuable, and impressive architectural masterpieces. Inside the walls of this former high-clerical residence, you can catch a glimpse into the luxurious and mysterious everyday lives of the archbishops.",
				icon: iconErseki,
				photo: photoErseki,
				left: 50.53,
				top: 47.63
			},
			{
				id: "egri-bazilika",
				title: "Basilica of Eger",
				text: "Admire the second-largest church in Hungary, a masterpiece of Neoclassical architecture. Its monumental interior and majestic organ are bound to leave you completely awestruck.",
				icon: iconBazilika,
				photo: photoBazilika,
				left: 52.45,
				top: 55.99
			},
			{
				id: "minaret",
				title: "Minaret",
				text: "Discover a true global rarity: a unique Ottoman-era prayer tower topped with a Christian cross! If you are not afraid of the narrow stairs, the top offers an unparalleled, breathtaking view of the entire city center.",
				icon: iconMinaret,
				photo: photoMinaret,
				left: 60.52,
				top: 34.02
			},
			{
				id: "szepasszony-volgy",
				title: "Szépasszony Valley",
				text: "When in Eger, wine is an absolute must, and this valley is the number one, most iconic spot for wine tasting in the city. Taste the famous Egri Bikavér (Bull's Blood) in the cozy wine cellars carved directly into the rhyolite tuff!",
				icon: iconSzepasszony,
				photo: photoSzepasszony,
				left: 8.86,
				top: 80.72
			},
			{
				id: "csillagvizsgalo",
				title: "Observatory",
				text: "Discover the oldest operational camera obscura on the continent, allowing you to spy on the city in real-time! Located at the top of the Lyceum building, this center also offers breathtaking views and exciting scientific adventures.",
				icon: iconCsillag,
				photo: photoCsillag,
				left: 61.66,
				top: 54.64
			},
			{
				id: "termalfurdo",
				title: "Thermal Bath",
				text: "Unwind in one of the country's most beautiful and greenest urban baths, set within a massive 5-hectare park! The 13 different pools and the healing thermal waters offer the perfect refreshment for the whole family after a day of sightseeing.",
				icon: iconTermal,
				photo: photoTermal,
				left: 83.35,
				top: 63.78
			}
		]}
	/>

	<Contact
		heading="Contact"
		intro="If you want to make a reservation or have any questions, we are waiting for your email or feel free to call us!"
		address="Tűzoltó square, Eger, Hungary"
		email="romvari.peter@gmail.com"
		phone="+36 30 638 7740"
		phoneName="Jolán Vincze"
		links={[
			{ name: "Airbnb", href: "https://airbnb.com/h/kastelyapartman", logo: airbnbLogoFull },
			{ name: "Booking.com", href: "https://www.booking.com/hotel/hu/kastely-apartman-eger.hu.html", logo: bookingLogoFull },
			{ name: "Szállás.hu", href: "https://szallas.hu/kastely-apartman-eger", logo: logoSzallas }
		]}
	/>
</Layout>