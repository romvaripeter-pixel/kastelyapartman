---
import { Image } from 'astro:assets';

interface Props {
	intro: string;
	image: ImageMetadata;
	title: string;
	text: string;
	gallery1: ImageMetadata;
	gallery2: ImageMetadata;
}

const { intro, image, title, text, gallery1, gallery2 } = Astro.props;
---

<section class="welcome fade-in-section">
	<div class="welcome-inner">
		<div class="welcome-intro">
			<p>{intro}</p>
		</div>

		<div class="welcome-feature">
		<div class="welcome-image-wrap">
			<Image
				src={image}
				alt={title}
				widths={[480, 800, 1200, 1600]}
				sizes="(max-width: 900px) 100vw, 66vw"
				format="webp"
				quality={82}
				class="welcome-image"
			/>
			<div class="welcome-whiteout"></div>
		</div>

		<div class="welcome-text">
			<h3>{title}</h3>
			<p>{text}</p>
		</div>
	</div>
	<div class="welcome-gallery">
			<div class="welcome-image-wrap gallery-reveal reveal-down">
				<Image
					src={gallery1}
					alt=""
					widths={[400, 700, 1000]}
					sizes="(max-width: 900px) 100vw, 50vw"
					format="webp"
					quality={82}
					class="gallery-img"
				/>
			</div>
			<div class="welcome-image-wrap gallery-reveal reveal-up">
				<Image
					src={gallery2}
					alt=""
					widths={[400, 700, 1000]}
					sizes="(max-width: 900px) 100vw, 50vw"
					format="webp"
					quality={82}
					class="gallery-img"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.welcome {
		padding: 6rem 2rem 3rem 2rem;
		background: #ffffff;
	}

	.welcome-inner {
		max-width: 1300px;
		margin: 0 auto;
	}

	.welcome-intro {
		max-width: 800px;
		margin: 0 0 4rem 0;
		text-align: left;
	}

	.welcome-intro p {
		font-family: 'Cormorant Garamond', serif;
		font-weight: 300;
		font-size: clamp(1.4rem, 2.4vw, 1.85rem);
		line-height: 1.65;
		color: #3a352f;
	}

	.welcome-feature {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.welcome-image-wrap {
		position: relative;
		overflow: hidden;
		border-radius: 4px;
		aspect-ratio: 4 / 3;
	}

	.welcome-image-wrap :global(.welcome-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transform: scale(1.18);
	}

	.welcome-image-wrap.in-view :global(.welcome-image) {
		animation: welcomeZoomOut 1.8s ease-out forwards;
	}

	@keyframes welcomeZoomOut {
		from { transform: scale(1.18); }
		to { transform: scale(1); }
	}

	.welcome-whiteout {
		position: absolute;
		inset: 0;
		background: #fff;
	}

	.welcome-image-wrap.in-view .welcome-whiteout {
		animation: welcomeWhiteFade 1.6s ease-out forwards;
	}

	@keyframes welcomeWhiteFade {
		from { opacity: 1; }
		to { opacity: 0; }
	}

	.welcome-text h3 {
		font-size: clamp(1.3rem, 2.4vw, 1.7rem);
		font-weight: 500;
		line-height: 1.4;
		margin: 0 0 1.2rem 0;
	}

	.welcome-text p {
		font-size: 1rem;
		line-height: 1.8;
		color: #555;
		margin: 0;
	}

	@media (max-width: 900px) {
		.welcome-feature {
			grid-template-columns: 1fr;
		}
	}
	.welcome-gallery {
		margin-top: 3rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.welcome-gallery .welcome-image-wrap {
		aspect-ratio: 4 / 3;
	}

	.welcome-gallery :global(.gallery-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		clip-path: inset(0% 0% 100% 0%);
		transform: scale(1.18);
		transition: clip-path 0.8s ease-out, transform 2.2s ease-out;
	}

	.welcome-gallery .reveal-up :global(.gallery-img) {
		clip-path: inset(100% 0% 0% 0%);
	}

	.welcome-gallery .gallery-reveal.in-view :global(.gallery-img) {
		clip-path: inset(0% 0% 0% 0%);
		transform: scale(1);
	}

	@keyframes revealDown {
		from { clip-path: inset(0% 0% 100% 0%); transform: scale(1.18); }
		to { clip-path: inset(0% 0% 0% 0%); transform: scale(1); }
	}

	@keyframes revealUp {
		from { clip-path: inset(100% 0% 0% 0%); transform: scale(1.18); }
		to { clip-path: inset(0% 0% 0% 0%); transform: scale(1); }
	}

	@media (max-width: 900px) {
		.welcome-gallery {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const imageWraps = document.querySelectorAll('.welcome-image-wrap:not(.gallery-reveal)');

	const imageObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('in-view');
					imageObserver.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.25 }
	);

	imageWraps.forEach((el) => imageObserver.observe(el));

	const galleryItems = document.querySelectorAll('.gallery-reveal');

	const galleryObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				entry.target.classList.toggle('in-view', entry.isIntersecting);
			});
		},
		{ threshold: 0.25 }
	);

	galleryItems.forEach((el) => galleryObserver.observe(el));
</script>