---
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	title: string;
	subtitle: string;
}

const { image, title, subtitle } = Astro.props;
---

<section class="hero">
	<Image
		src={image}
		alt={title}
		class="hero-image"
		widths={[640, 1080, 1600, 2000]}
		sizes="100vw"
		format="webp"
		quality={80}
		loading="eager"
	/>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<h1>{title}</h1>
		<p>{subtitle}</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: 100vh;
		width: 100%;
		overflow: hidden;
	}

	.hero-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.25);
	}

	.hero-content {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		color: white;
	}

	.hero-content h1,
	.hero-content p {
		opacity: 0;
		animation: fadeInUp 1s ease-out forwards;
	}

	.hero-content p {
		animation-delay: 0.3s;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-content h1 {
		font-size: clamp(2rem, 6vw, 4rem);
		margin: 0;
		font-weight: 400;
		letter-spacing: 0.02em;
	}

	.hero-content p {
		font-size: clamp(1rem, 2vw, 1.3rem);
		margin-top: 0.5rem;
		opacity: 0.9;
	}
</style>